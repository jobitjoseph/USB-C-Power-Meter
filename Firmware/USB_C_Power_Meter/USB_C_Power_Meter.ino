static void draw_GraphV(const Readings &r, uint8_t idx, uint8_t total) {
  char v[10];
  fmtVoltage(v, sizeof(v), r.voltage);
  drawGraphScreen("VOLTAGE", v, "V", V_COLOR, r.vHist, r.histCount, idx, total);
}

static void draw_GraphI(const Readings &r, uint8_t idx, uint8_t total) {
  char i[10];
  fmtCurrent(i, sizeof(i), r.current);
  drawGraphScreen("CURRENT", i, "A", I_COLOR, r.iHist, r.histCount, idx, total);
}

static void draw_GraphP(const Readings &r, uint8_t idx, uint8_t total) {
  char p[10];
  fmtPower(p, sizeof(p), r.power);
  drawGraphScreen("POWER", p, "W", P_COLOR, r.pHist, r.histCount, idx, total);
}

static void draw_GraphCombined(const Readings &r, uint8_t idx, uint8_t total) {
  Display::clearScreen();
  Display::drawTag("VOLT + CURR", LABEL_COLOR, TFT_W / 2, 5, 1);

  char v[10], i[10];
  fmtVoltage(v, sizeof(v), r.voltage);
  fmtCurrent(i, sizeof(i), r.current);
  // two short value groups side by side on the same line
  Display::drawValueUnit(v, "V", V_COLOR, V_COLOR_DIM, TFT_W / 2 - 20, 17, 40, 12, 5);
  Display::drawValueUnit(i, "A", I_COLOR, I_COLOR_DIM, TFT_W / 2 + 20, 17, 40, 12, 5);

  Display::Series series[2] = {
      {r.vHist, r.histCount, V_COLOR, true},
      {r.iHist, r.histCount, I_COLOR, false},
  };
  Display::drawGraph(5, 26, TFT_W - 10, TFT_H - 26 - DOTS_MARGIN, series, 2);
  Display::drawDots(idx, total);
  Display::present();
}

// ============================================================
//  SCREEN REGISTRY — edit this array to rearrange / enable /
//  disable screens. Navigation order follows array order; set
//  `enabled = false` to hide a screen from Next/Prev without
//  deleting its code. Nothing else in the sketch needs to change.
// ============================================================
typedef void (*DrawFn)(const Readings &, uint8_t, uint8_t);
struct ScreenDef {
  const char *name;
  DrawFn draw;
  bool enabled;
};

static ScreenDef SCREENS[] = {
    {"V / I / P", draw_VIP, true},
    {"V / I / mAh", draw_VImAh, true},
    {"V / I / Wh", draw_VIWh, true},
    {"Temp / Session", draw_TempSession, true},
    {"Min (V/I/P)", draw_Min, true},
    {"Max (V/I/P)", draw_Max, true},
    {"Avg (V/I/P)", draw_Avg, true},
    {"Voltage graph", draw_GraphV, true},
    {"Current graph", draw_GraphI, true},
    {"Power graph", draw_GraphP, true},
    {"Combined V+I graph", draw_GraphCombined, true},
};
static const uint8_t SCREEN_COUNT = sizeof(SCREENS) / sizeof(SCREENS[0]);

static int8_t currentScreen = -1;

static uint8_t countEnabled() {
  uint8_t n = 0;
  for (uint8_t i = 0; i < SCREEN_COUNT; i++)
    if (SCREENS[i].enabled) n++;
  return n;
}

static uint8_t enabledPositionOf(int8_t screenIndex) {
  uint8_t pos = 0;
  for (uint8_t i = 0; i < screenIndex; i++)
    if (SCREENS[i].enabled) pos++;
  return pos;
}

void begin() {
  currentScreen = 0;
  while (currentScreen < SCREEN_COUNT - 1 && !SCREENS[currentScreen].enabled) currentScreen++;
}

void next() {
  if (SCREEN_COUNT == 0) return;
  uint8_t start = currentScreen;
  do {
    currentScreen = (currentScreen + 1) % SCREEN_COUNT;
  } while (!SCREENS[currentScreen].enabled && currentScreen != start);
}

void prev() {
  if (SCREEN_COUNT == 0) return;
  uint8_t start = currentScreen;
  do {
    currentScreen = (currentScreen + SCREEN_COUNT - 1) % SCREEN_COUNT;
  } while (!SCREENS[currentScreen].enabled && currentScreen != start);
}

void draw(const Readings &r) {
  if (currentScreen < 0 || currentScreen >= SCREEN_COUNT) return;
  if (!SCREENS[currentScreen].enabled) {
    Display::clearScreen();
    Display::drawTag("ALL SCREENS", LABEL_COLOR, TFT_W / 2, TFT_H / 2 - 8, 1);
    Display::drawTag("DISABLED", LABEL_COLOR, TFT_W / 2, TFT_H / 2 + 8, 1);
    Display::present();
    return;
  }
  uint8_t total = countEnabled();
  uint8_t pos = enabledPositionOf(currentScreen);
  SCREENS[currentScreen].draw(r, pos, total);
}

} // namespace Screens

// ============================================================
//  BUTTONS
// ============================================================
// PA13 pages forward, PA15 pages back. PA14 flips the display 180° on a
// tap and resets the session on a 1.5s hold.
const unsigned long DEBOUNCE_MS = 25;
const unsigned long HOLD_MS = 1500;

Button btnNext = { SW_NEXT_BIT };
Button btnPrev = { SW_PREV_BIT };
Button btnRot  = { SW_ROT_BIT };

bool needFullRedraw = false;

// returns true on press edge (debounced)
bool pollEdge(Button &b, bool &releaseEdge) {
  releaseEdge = false;
  bool raw = gpioActiveLow(b.pinBit);
  unsigned long now = millis();
  if (raw != b.lastRaw) {
    b.lastRaw = raw;
    b.lastChangeMs = now;
  }
  if ((now - b.lastChangeMs) > DEBOUNCE_MS && b.stable != raw) {
    b.stable = raw;
    if (b.stable) {
      return true; // press edge
    } else {
      releaseEdge = true;
    }
  }
  return false;
}

void handleButtons() {
  bool rel;

  if (pollEdge(btnNext, rel)) {
    Screens::next();
    needFullRedraw = true;
  }

  if (pollEdge(btnPrev, rel)) {
    Screens::prev();
    needFullRedraw = true;
  }

  // PA14: tap = flip 180°, hold 1.5s = reset
  bool relRot;
  bool pressedRot = pollEdge(btnRot, relRot);
  if (pressedRot) {
    btnRot.pressStartMs = millis();
    btnRot.holdFired = false;
  }
  if (btnRot.stable && !btnRot.holdFired) {
    if (millis() - btnRot.pressStartMs >= HOLD_MS) {
      btnRot.holdFired = true;
      PowerSensor::reset();
      needFullRedraw = true;
    }
  }
  if (relRot && !btnRot.holdFired) {
    // tap: flip the display 180°
    Display::toggleFlip();
    needFullRedraw = true;
  }
}

// ============================================================
//  SETUP / LOOP
// ============================================================
const unsigned long TICK_MS = 500; // display refresh cadence

void setup() {
  gpioInput(SW_NEXT_BIT);
  gpioInput(SW_PREV_BIT);
  gpioInput(SW_ROT_BIT);

  Serial.begin(115200);

  Display::begin();
  Display::applyRotation();
  Display::playBootAnimation();

  if (!PowerSensor::begin()) {
    // PAC1811 did not answer on I2C — report it rather than showing a
    // blank or garbled screen.
    Display::clearScreen();
    Display::drawTag("PAC1811", 0xF800, TFT_W / 2, TFT_H / 2 - 8, 1);
    Display::drawTag("NOT FOUND", 0xF800, TFT_W / 2, TFT_H / 2 + 8, 1);
    Display::present();
    while (1) { delay(1000); }
  }

  Screens::begin();
  Screens::draw(PowerSensor::data());
}

void loop() {
  handleButtons();
  PowerSensor::update();

  static unsigned long lastDraw = 0;
  unsigned long now = millis();
  if (needFullRedraw || (now - lastDraw) >= TICK_MS) {
    // Clear the flag before drawing: present() polls buttons mid-frame,
    // and a press landing during the blit must not be discarded afterwards.
    needFullRedraw = false;
    Screens::draw(PowerSensor::data());
    lastDraw = now;
  }
}