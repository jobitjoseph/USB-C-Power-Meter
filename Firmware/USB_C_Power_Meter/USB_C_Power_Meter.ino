// ============================================================
//  DISPLAY — ST7735 driver wrapper + auto-fit big-digit rendering
// ============================================================
namespace Display {

struct Series {
  const float *data;
  uint8_t count;
  uint16_t color;
  bool fill;
};

// The library keeps the panel's RAM address offsets (_xstart/_ystart)
// protected with no public setter, and computes them for the un-flipped
// MADCTL. Flipping MX reverses the scan direction and moves where those
// offsets belong, so the window lands a couple of pixels off. This thin
// subclass exposes a setter to correct them after the MADCTL override.
class ST7735Fixed : public Adafruit_ST7735 {
public:
  ST7735Fixed(int8_t cs, int8_t dc, int8_t mosi, int8_t sclk, int8_t rst)
      : Adafruit_ST7735(cs, dc, mosi, sclk, rst) {}
  void setOffsets(int16_t xstart, int16_t ystart) {
    _xstart = xstart;
    _ystart = ystart;
  }
};

ST7735Fixed tft(TFT_CS, TFT_DC, TFT_MOSI, TFT_SCK, TFT_RST);

static bool flipped180 = false;

// Re-applies the rotation, the MADCTL override and the RAM offsets for
// the current orientation. Both orientations are 160x80 landscape,
// scanned in opposite directions; the offsets are identical for both
// because the panel sits centred in the driver RAM.
static void applyRotation() {
  tft.setRotation(flipped180 ? 3 : 1);
  uint8_t madctl = flipped180 ? TFT_MADCTL_LANDSCAPE_180 : TFT_MADCTL_LANDSCAPE;
  tft.sendCommand(ST77XX_MADCTL, &madctl, 1);
  tft.setOffsets(TFT_X_OFFSET, TFT_Y_OFFSET);
}

// Tap on the middle button: flip the whole UI 180°. The next
// Screens::draw() repaints every pixel, so no explicit clear is needed.
void toggleFlip() {
  flipped180 = !flipped180;
  applyRotation();
}

void begin() {
  pinMode(TFT_BL, OUTPUT);
  digitalWrite(TFT_BL, HIGH);

  // INITR_MINI160x80 is the standard init sequence for 160x80 ST7735 IPS
  // panels. If colours come out wrong or offset, try INITR_MINI160x80_PLUGIN
  // here first.
  tft.initR(INITR_MINI160x80);

  // See TFT_INVERT.
  tft.invertDisplay(TFT_INVERT);

  applyRotation();

  tft.cp437(true); // standard CP437 glyph mapping, so 0xF8 renders as the degree sign
  tft.fillScreen(BG_BLACK);
}

// Flicker-free redraw: the whole 160x80 frame is composed in this
// off-screen canvas and pushed to the panel in one SPI burst via
// present(), rather than clearing the live screen and redrawing over it.
// 160*80*2 = 25,600 bytes of the SAMD21G18A's 32KB SRAM, leaving ~7KB for
// globals, sensor state and the call stack. If the allocation ever fails,
// GFXcanvas16 degrades to a no-op on every draw call rather than
// corrupting memory.
static GFXcanvas16 canvas(TFT_W, TFT_H);

void clearScreen(uint16_t bg = BG_BLACK) { canvas.fillScreen(bg); }

// Pushes the composed frame to the panel in one batched SPI burst. Call
// once per redraw, after all of that frame's drawXxx() calls.
//
// This deliberately avoids tft.drawRGBBitmap(): that helper writes the
// frame one pixel at a time through writePixel(), each call re-sending
// the address window. Over software SPI that costs on the order of a
// second per 160x80 frame, during which loop() never returns and button
// polling stalls. setAddrWindow() + writePixels() streams the contiguous
// canvas buffer in a single burst instead.
void present() {
  // Streamed in strips with a button poll between each. Even batched, a
  // full frame over bit-banged SPI takes long enough that a quick tap can
  // start and end entirely inside one present() call and never be seen by
  // loop()'s poll. Polling every 10 rows keeps the gap between button
  // samples to a few milliseconds.
  uint16_t *buf = canvas.getBuffer();
  const int STRIP_ROWS = 10;
  for (int y = 0; y < TFT_H; y += STRIP_ROWS) {
    int h = (TFT_H - y) < STRIP_ROWS ? (TFT_H - y) : STRIP_ROWS;
    tft.startWrite();
    tft.setAddrWindow(0, y, TFT_W, h);
    tft.writePixels(buf + (uint32_t)y * TFT_W, (uint32_t)TFT_W * h);
    tft.endWrite();
    handleButtons(); // safe: only flips state flags, never draws
  }
}

// Largest integer text-size (1..maxSize) whose bounding box fits within
// availW x availH, using the built-in 5x7 font — the fallback for boxes
// too small for even the smallest smooth font below.
static uint8_t fitSize(const char *text, int availW, int availH, uint8_t maxSize) {
  int16_t x1, y1;
  uint16_t w, h;
  canvas.setFont(nullptr);
  canvas.setTextSize(1);
  canvas.getTextBounds(text, 0, 0, &x1, &y1, &w, &h);
  if (w < 1) w = 1;
  if (h < 1) h = 1;
  uint8_t byW = availW / w;
  uint8_t byH = availH / h;
  uint8_t s = byW < byH ? byW : byH;
  if (s < 1) s = 1;
  if (s > maxSize) s = maxSize;
  return s;
}

// Value fonts, largest first. Values render with the biggest of these
// whose glyphs fit the box at native size; custom GFX fonts must never be
// integer-scaled. If even 9pt does not fit, fall back to the scaled
// built-in font.
static const GFXfont *BIG_FONTS[] = {
    &FreeSansBold24pt7b, &FreeSansBold18pt7b, &FreeSansBold12pt7b, &FreeSansBold9pt7b};

static const GFXfont *pickFont(const char *text, int availW, int availH, int extraW) {
  for (uint8_t i = 0; i < sizeof(BIG_FONTS) / sizeof(BIG_FONTS[0]); i++) {
    canvas.setFont(BIG_FONTS[i]);
    canvas.setTextSize(1);
    int16_t x1, y1;
    uint16_t w, h;
    canvas.getTextBounds(text, 0, 0, &x1, &y1, &w, &h);
    if ((int)w + extraW <= availW && (int)h <= availH) return BIG_FONTS[i];
  }
  canvas.setFont(nullptr);
  return nullptr;
}

void drawValueUnit(const char *value, const char *unit,
                    uint16_t valueColor, uint16_t unitColor,
                    int cx, int cy, int availW, int availH,
                    uint8_t maxSize) {
  // The FreeSans faces are ASCII-only, so the CP437 degree glyph (\xF8)
  // used by the temperature screen cannot come from the font. A leading
  // \xF8 in `unit` is stripped here and drawn as a small ring instead.
  bool degree = (unit && (uint8_t)unit[0] == 0xF8);
  const char *unitText = degree ? unit + 1 : unit;

  char combined[24];
  snprintf(combined, sizeof(combined), "%s%s", value, unitText);

  const GFXfont *font = pickFont(combined, availW, availH, degree ? 10 : 0);
  if (font) {
    canvas.setFont(font);
    canvas.setTextSize(1);
  } else {
    canvas.setFont(nullptr);
    canvas.setTextSize(fitSize(combined, availW, availH, maxSize));
  }

  int16_t vx1, vy1, ux1, uy1;
  uint16_t vw, vh, uw, uh;
  canvas.getTextBounds(value, 0, 0, &vx1, &vy1, &vw, &vh);
  canvas.getTextBounds(unitText, 0, 0, &ux1, &uy1, &uw, &uh);

  int r = vh / 9;
  if (r < 2) r = 2;                       // degree-ring radius scales with the digits
  int degW = degree ? (2 * r + 4) : 0;    // ring + breathing room

  int totalW = vw + degW + uw;
  int startX = cx - totalW / 2;
  int baseY = cy - vh / 2;

  canvas.setTextColor(valueColor);
  canvas.setCursor(startX - vx1, baseY - vy1);
  canvas.print(value);

  if (degree) {
    int dcx = startX + vw + 2 + r;
    int dcy = baseY + r;
    canvas.drawCircle(dcx, dcy, r, unitColor);
    canvas.drawCircle(dcx, dcy, r - 1, unitColor); // doubled ring so it reads at size
  }

  canvas.setTextColor(unitColor);
  canvas.setCursor(startX + vw + degW - ux1, baseY - uy1);
  canvas.print(unitText);

  canvas.setFont(nullptr); // restore the built-in font for small labels/tags
}

void drawTag(const char *text, uint16_t color, int cx, int cy, uint8_t size) {
  canvas.setFont(nullptr); // tags always use the built-in small font
  canvas.setTextSize(size);
  int16_t x1, y1;
  uint16_t w, h;
  canvas.getTextBounds(text, 0, 0, &x1, &y1, &w, &h);
  canvas.setTextColor(color, BG_BLACK);
  canvas.setCursor(cx - w / 2 - x1, cy - h / 2 - y1);
  canvas.print(text);
}

void hline(int x, int y, int w, uint16_t color) { canvas.drawFastHLine(x, y, w, color); }

void drawDots(uint8_t activeIndex, uint8_t total) {
  if (total == 0) return;
  const int r = 1;
  const int gap = 6;
  int totalW = (total - 1) * gap;
  int startX = (TFT_W - totalW) / 2;
  int y = TFT_H - 4;
  for (uint8_t i = 0; i < total; i++) {
    uint16_t c = (i == activeIndex) ? DOT_ON : DOT_DIM;
    canvas.fillCircle(startX + i * gap, y, r, c);
  }
}

void drawGraph(int x, int y, int w, int h, const Series *series, uint8_t seriesCount) {
  canvas.drawFastHLine(x, y + h / 2, w, LINE_COLOR);
  for (uint8_t s = 0; s < seriesCount; s++) {
    const Series &sr = series[s];
    if (sr.count < 2) continue;
    float mn = sr.data[0], mx = sr.data[0];
    for (uint8_t i = 1; i < sr.count; i++) {
      if (sr.data[i] < mn) mn = sr.data[i];
      if (sr.data[i] > mx) mx = sr.data[i];
    }
    float span = (mx - mn);
    if (span < 0.0001f) span = 1.0f;

    int prevX = x, prevY = y;
    for (uint8_t i = 0; i < sr.count; i++) {
      int px = x + (int)((float)i / (sr.count - 1) * w);
      int py = y + h - (int)((sr.data[i] - mn) / span * h);
      if (i > 0) {
        canvas.drawLine(prevX, prevY, px, py, sr.color);
        if (sr.fill) canvas.drawLine(px, py, px, y + h, sr.color);
      }
      prevX = px;
      prevY = py;
      if (i == sr.count - 1) canvas.fillCircle(px, py, 2, sr.color);
    }
  }
}

void playBootAnimation() {
  tft.fillScreen(WHITE);
  int lx = (TFT_W - LOGO_W) / 2;
  int ly = (TFT_H - LOGO_H) / 2 - 6;
  tft.drawRGBBitmap(lx, ly, LOGO_BITMAP, LOGO_W, LOGO_H);

  const int barW = 60, barH = 2;
  int barX = (TFT_W - barW) / 2;
  int barY = ly + LOGO_H + 14;
  tft.drawRect(barX - 1, barY - 1, barW + 2, barH + 2, 0xC618); // faint track outline
  tft.fillRect(barX, barY, barW, barH, WHITE);

  uint32_t start = millis();
  int lastFilled = 0;
  while (millis() - start < BOOT_BAR_MS) {
    float t = (float)(millis() - start) / BOOT_BAR_MS;
    int filled = (int)(t * barW);
    if (filled > lastFilled) {
      tft.fillRect(barX + lastFilled, barY, filled - lastFilled, barH, V_COLOR);
      lastFilled = filled;
    }
  }
  tft.fillRect(barX, barY, barW, barH, V_COLOR);
  delay(BOOT_HOLD_MS);
}

} // namespace Display

// ============================================================
//  FIXED-WIDTH NUMBER FORMATTING
// ============================================================
void fmtFixed(char *buf, size_t bufSize, float value, uint8_t intDigits, uint8_t decDigits) {
  bool neg = value < 0;
  if (neg) value = -value;

  long scale = 1;
  for (uint8_t i = 0; i < decDigits; i++) scale *= 10;

  long scaled = (long)(value * scale + 0.5f);
  long intPart = scaled / scale;
  long fracPart = scaled % scale;

  if (decDigits > 0) {
    snprintf(buf, bufSize, "%s%0*ld.%0*ld", neg ? "-" : "", intDigits, intPart, decDigits, fracPart);
  } else {
    snprintf(buf, bufSize, "%s%0*ld", neg ? "-" : "", intDigits, intPart);
  }
}

void fmtVoltage(char *buf, size_t bufSize, float v) { fmtFixed(buf, bufSize, v, 2, 3); }
void fmtCurrent(char *buf, size_t bufSize, float a) { fmtFixed(buf, bufSize, a, 1, 4); }

void fmtPower(char *buf, size_t bufSize, float w) {
  if (w < 10.0f) fmtFixed(buf, bufSize, w, 1, 4);
  else if (w < 100.0f) fmtFixed(buf, bufSize, w, 2, 3);
  else fmtFixed(buf, bufSize, w, 3, 2);
}

void fmtMah(char *buf, size_t bufSize, float mah) { fmtFixed(buf, bufSize, mah, 4, 0); }
void fmtWh(char *buf, size_t bufSize, float wh) { fmtFixed(buf, bufSize, wh, 2, 2); }
void fmtTemp(char *buf, size_t bufSize, float c) { fmtFixed(buf, bufSize, c, 2, 1); }

void fmtHMS(char *buf, size_t bufSize, uint32_t totalSeconds) {
  uint32_t h = totalSeconds / 3600;
  uint32_t m = (totalSeconds % 3600) / 60;
  uint32_t s = totalSeconds % 60;
  snprintf(buf, bufSize, "%02lu:%02lu:%02lu", (unsigned long)h, (unsigned long)m, (unsigned long)s);
}

