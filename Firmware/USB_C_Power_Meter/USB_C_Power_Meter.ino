namespace Screens {

// One row of a big-digit screen: a value string, its unit, and the two
// colours drawValueUnit() needs (full-bright value, dimmed unit).
struct VU {
  const char *value;
  const char *unit;
  uint16_t color;
  uint16_t colorDim;
};

static const int DOTS_MARGIN = 7; // bottom strip reserved for the page dots

// Every screen is composed into the shared off-screen canvas and pushed
// to the panel in one operation via Display::present(). The live panel is
// never cleared directly.

static void drawTriple(const VU rows[3], const char *tag, uint8_t dotIndex, uint8_t dotTotal) {
  int contentH = TFT_H - DOTS_MARGIN;
  int tagH = tag ? 13 : 0;
  int rowsH = contentH - tagH;
  int rowH = rowsH / 3;
  int extra = rowsH - rowH * 3;

  Display::clearScreen();
  int y = 0;
  if (tag) {
    Display::drawTag(tag, LABEL_COLOR, TFT_W / 2, tagH / 2, 1);
    y = tagH;
  }
  for (uint8_t i = 0; i < 3; i++) {
    int thisH = rowH + (i == 2 ? extra : 0);
    Display::drawValueUnit(rows[i].value, rows[i].unit, rows[i].color, rows[i].colorDim,
                            TFT_W / 2, y + thisH / 2, TFT_W - 10, thisH - 2, 8);
    y += thisH;
  }
  Display::drawDots(dotIndex, dotTotal);
  Display::present();
}

static void drawDuo(const VU &a, const VU &b, uint8_t dotIndex, uint8_t dotTotal) {
  Display::clearScreen();
  int contentH = TFT_H - DOTS_MARGIN;
  int rowH = contentH / 2;

  // availH = rowH-2 rather than rowH-4: those 2px are what let the 24pt
  // face (~34px digits) qualify on the temperature readout.
  Display::drawValueUnit(a.value, a.unit, a.color, a.colorDim, TFT_W / 2, rowH / 2, TFT_W - 14, rowH - 2, 8);
  Display::hline(14, rowH, TFT_W - 28, LINE_COLOR);
  Display::drawValueUnit(b.value, b.unit, b.color, b.colorDim, TFT_W / 2, rowH + rowH / 2, TFT_W - 14, rowH - 2, 8);

  Display::drawDots(dotIndex, dotTotal);
  Display::present();
}

static void drawGraphScreen(const char *label, const char *val, const char *unit, uint16_t color,
                             const float *hist, uint8_t histCount, uint8_t dotIndex, uint8_t dotTotal) {
  Display::clearScreen();
  Display::drawTag(label, LABEL_COLOR, TFT_W / 2, 5, 1);
  Display::drawValueUnit(val, unit, color, color, TFT_W / 2, 17, TFT_W - 20, 14, 6); // 14px: tall enough for the 9pt face

  Display::Series s = {hist, histCount, color, true};
  Display::drawGraph(5, 26, TFT_W - 10, TFT_H - 26 - DOTS_MARGIN, &s, 1);
  Display::drawDots(dotIndex, dotTotal);
  Display::present();
}

// ---------------- individual screens ----------------

static void draw_VIP(const Readings &r, uint8_t idx, uint8_t total) {
  char v[10], i[10], p[10];
  fmtVoltage(v, sizeof(v), r.voltage);
  fmtCurrent(i, sizeof(i), r.current);
  fmtPower(p, sizeof(p), r.power);
  VU rows[3] = {
      {v, "V", V_COLOR, V_COLOR_DIM},
      {i, "A", I_COLOR, I_COLOR_DIM},
      {p, "W", P_COLOR, P_COLOR_DIM},
  };
  drawTriple(rows, nullptr, idx, total);
}

static void draw_VImAh(const Readings &r, uint8_t idx, uint8_t total) {
  char v[10], i[10], m[10];
  fmtVoltage(v, sizeof(v), r.voltage);
  fmtCurrent(i, sizeof(i), r.current);
  fmtMah(m, sizeof(m), r.mAh);
  VU rows[3] = {
      {v, "V", V_COLOR, V_COLOR_DIM},
      {i, "A", I_COLOR, I_COLOR_DIM},
      {m, "mAh", MAH_COLOR, MAH_COLOR_DIM},
  };
  drawTriple(rows, nullptr, idx, total);
}

static void draw_VIWh(const Readings &r, uint8_t idx, uint8_t total) {
  char v[10], i[10], w[10];
  fmtVoltage(v, sizeof(v), r.voltage);
  fmtCurrent(i, sizeof(i), r.current);
  fmtWh(w, sizeof(w), r.Wh);
  VU rows[3] = {
      {v, "V", V_COLOR, V_COLOR_DIM},
      {i, "A", I_COLOR, I_COLOR_DIM},
      {w, "Wh", WH_COLOR, WH_COLOR_DIM},
  };
  drawTriple(rows, nullptr, idx, total);
}

static void draw_TempSession(const Readings &r, uint8_t idx, uint8_t total) {
  char t[10], hms[12];
  fmtTemp(t, sizeof(t), r.temperatureC);
  fmtHMS(hms, sizeof(hms), r.sessionSeconds);
  VU a = {t, "\xF8"
              "C",
          T_COLOR, T_COLOR_DIM}; // \xF8 = degree glyph in the built-in CP437 font
  VU b = {hms, "", WH_COLOR, WH_COLOR_DIM};
  drawDuo(a, b, idx, total);
}

static void draw_Min(const Readings &r, uint8_t idx, uint8_t total) {
  char v[10], i[10], p[10];
  fmtVoltage(v, sizeof(v), r.vMin);
  fmtCurrent(i, sizeof(i), r.iMin);
  fmtPower(p, sizeof(p), r.pMin);
  VU rows[3] = {{v, "V", V_COLOR, V_COLOR_DIM}, {i, "A", I_COLOR, I_COLOR_DIM}, {p, "W", P_COLOR, P_COLOR_DIM}};
  drawTriple(rows, "MIN", idx, total);
}

static void draw_Max(const Readings &r, uint8_t idx, uint8_t total) {
  char v[10], i[10], p[10];
  fmtVoltage(v, sizeof(v), r.vMax);
  fmtCurrent(i, sizeof(i), r.iMax);
  fmtPower(p, sizeof(p), r.pMax);
  VU rows[3] = {{v, "V", V_COLOR, V_COLOR_DIM}, {i, "A", I_COLOR, I_COLOR_DIM}, {p, "W", P_COLOR, P_COLOR_DIM}};
  drawTriple(rows, "MAX", idx, total);
}

static void draw_Avg(const Readings &r, uint8_t idx, uint8_t total) {
  char v[10], i[10], p[10];
  fmtVoltage(v, sizeof(v), r.vAvg);
  fmtCurrent(i, sizeof(i), r.iAvg);
  fmtPower(p, sizeof(p), r.pAvg);
  VU rows[3] = {{v, "V", V_COLOR, V_COLOR_DIM}, {i, "A", I_COLOR, I_COLOR_DIM}, {p, "W", P_COLOR, P_COLOR_DIM}};
