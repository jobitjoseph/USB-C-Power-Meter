// ============================================================
//  PIN MAP & CONFIG — ATSAMD21G18A-MFT
// ============================================================

// ST7735 160x80 IPS display — software SPI (MOSI/SCK are plain GPIO,
// not the hardware SPI pins). CS is tied to GND on the board, so it is
// passed to the display library as -1.
#define TFT_CS   -1     // tied to GND on the board
#define TFT_DC    A4    // RS / DC          (PA05)
#define TFT_RST   8     // RST              (PA06)
#define TFT_BL    9     // Backlight (PWM)  (PA07)
#define TFT_MOSI  1     // MOSI             (PA10)
#define TFT_SCK   0     // SCK              (PA11)

#define TFT_W 160
#define TFT_H 80

// This panel presents RGB as its bitwise complement. invertDisplay(true)
// corrects it; a BGR/RGB MADCTL swap does not.
#define TFT_INVERT true

// This panel's column driver runs opposite to what INITR_MINI160x80
// assumes, so every rotation needs its MX bit (0x40) flipped from the
// library's stock value. Stock per-rotation MADCTL is (MX|MY, MY|MV,
// 0x00, MX|MV) for rotations 0..3; with MX flipped that becomes
// (MY, MY|MV|MX, MX, MV) = (0x80, 0xE0, 0x40, 0x20). Only rotation 1
// (landscape) and rotation 3 (the same view flipped 180°) are used.
#define TFT_MADCTL_LANDSCAPE      0xE0 // rotation 1, MX flipped from stock MY|MV
#define TFT_MADCTL_LANDSCAPE_180  0x20 // rotation 3, MX flipped from stock MX|MV

// RAM address offsets. The library's rotation-1 defaults for this panel
// are x=0, y=24, but flipping MX (above) moves where the offsets belong
// and leaves a thin unwritten strip at the right and bottom edges.
// x=1 centres the 160px window in the driver's 162px RAM; y=26 matches
// the 26-row variant of this panel. Both values are the exact centre of
// their axis (162-160=2 -> 1, 132-80=52 -> 26), so the same offsets hold
// in the 180°-flipped orientation and the flip needs only the MADCTL swap.
// If a sliver remains on an edge, nudge that axis by ±1–2: a larger value
// moves the image toward that edge, a smaller one away from it.
#define TFT_X_OFFSET 1
#define TFT_Y_OFFSET 26

// Buttons — active LOW, with external 10k pull-ups on the board, so the
// internal pull-ups are left disabled.
// PA13/PA14/PA15 are not usable via Arduino's pin API on this board
// profile: variant.h caps PINS_COUNT at 26, so even though PA13 has an
// entry further down in variant.cpp's g_APinDescription[] table,
// pinMode(), digitalRead() and attachInterrupt() only recognise pins
// 0..25. These three are therefore driven with direct SAMD21 PORT
// register access — see gpioInput() and gpioActiveLow() below.
#define SW_NEXT_BIT  13   // PA13
#define SW_ROT_BIT   14   // PA14 — tap = flip display 180°, hold 1.5s = reset
#define SW_PREV_BIT  15   // PA15

// PAC1811T-2E power monitor — I2C on the board's default SDA/SCL
#define PAC1811_I2C_ADDR   0x40
#define PAC1811_SHUNT_MOHM 10.0f   // 10 milliohm shunt (R4)

// How often the power sensor is sampled and integrated for mAh/Wh (ms)
#define SAMPLE_INTERVAL_MS  100

// Boot animation timing (ms)
#define BOOT_LOGO_MS      650   // scale/fade-in duration
#define BOOT_BAR_MS       1100  // progress bar fill duration
#define BOOT_HOLD_MS      250   // hold after bar completes before switching to dashboard

// ============================================================
//  BUTTON TYPE + GPIO HELPERS
// ============================================================
// Declared before any function in the file: the IDE inserts its
// auto-generated prototypes right before the first function definition,
// so any type used in a later function signature must exist by here.
struct Button {
  uint8_t pinBit;
  bool stable;
  bool lastRaw;
  unsigned long lastChangeMs;
  unsigned long pressStartMs;
  bool holdFired;
  Button(uint8_t b) : pinBit(b), stable(false), lastRaw(false),
    lastChangeMs(0), pressStartMs(0), holdFired(false) {}
};

// PA13/PA14/PA15 are not on this board profile's pin table (variant.h
// caps PINS_COUNT at 26), so they are configured and read through the
// SAMD21 PORT registers instead of pinMode()/digitalRead().
static inline void gpioInput(uint8_t bit) {
  PORT->Group[0].DIRCLR.reg = (1u << bit);
  PORT->Group[0].PINCFG[bit].bit.INEN = 1;
  PORT->Group[0].PINCFG[bit].bit.PULLEN = 0; // external pull-ups already present
  PORT->Group[0].PINCFG[bit].bit.PMUXEN = 0;
}
static inline bool gpioActiveLow(uint8_t bit) {
  return !(PORT->Group[0].IN.reg & (1u << bit));
}

// Defined in the BUTTONS section near the bottom, where Screens and
// PowerSensor are available. Forward-declared here because
// Display::present() calls it between SPI strips.
void handleButtons();

// ============================================================
//  COLOUR PALETTE (RGB565)
// ============================================================

#define BG_BLACK      0x0000
#define WHITE         0xFFFF
#define LABEL_COLOR   0xFFFF   // small captions / tag text
#define LINE_COLOR    0x2146   // hairline divider between duo-screen rows
#define DOT_DIM       0x1926   // inactive page-indicator dot
#define DOT_ON        V_COLOR  // active page-indicator dot

#define V_COLOR       0x3EBF   // voltage — cyan
#define I_COLOR       0xFDA9   // current — amber
#define P_COLOR       0x5734   // power — green
#define T_COLOR       0xC4DF   // temperature — violet
#define MAH_COLOR     0xFAF6   // charge — pink
#define WH_COLOR      0xFE87   // energy / session time — gold
// Unit suffixes currently track the value colour; give these separate
// darker values to render units dimmer than their digits.
#define V_COLOR_DIM   0x3EBF
#define I_COLOR_DIM   0xFDA9
#define P_COLOR_DIM   0x5734
#define T_COLOR_DIM   0xC4DF
#define MAH_COLOR_DIM 0xFAF6
#define WH_COLOR_DIM  0xFE87

// ============================================================
//  SENSOR READINGS
// ============================================================
#define GRAPH_POINTS 30 // ~30s history at 1 sample/sec for the graph screens

struct Readings {
  float voltage = 0, current = 0, power = 0;     // live
  float vMin = 0, vMax = 0, vAvg = 0;
  float iMin = 0, iMax = 0, iAvg = 0;
  float pMin = 0, pMax = 0, pAvg = 0;
  float mAh = 0;                                  // charge from the PAC1811 hardware accumulator
  float Wh = 0;                                   // derived: (mAh/1000) * vAvg
  float temperatureC = 0;                         // SAMD21 die temperature
  uint32_t sessionSeconds = 0;
  float vHist[GRAPH_POINTS] = {0};
  float iHist[GRAPH_POINTS] = {0};
  float pHist[GRAPH_POINTS] = {0};
  uint8_t histCount = 0;                          // how many of the above are valid yet
};

