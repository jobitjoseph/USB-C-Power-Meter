static TemperatureZero tempZero;
static Readings r;

static uint32_t lastSampleMs = 0;
static uint32_t lastHistMs = 0;
static uint32_t sessionStartMs = 0;
static uint32_t sampleCount = 0;
static double vSum = 0, iSum = 0, pSum = 0;

void reset(); // used by begin() below; defined further down

bool begin() {
  Wire.begin();

  if (!pac.begin(PAC1811_I2C_ADDR)) {
    return false;
  }
  pac.setShuntMilliOhms(PAC1811_SHUNT_MOHM);

  // The chip can accumulate either power or sense charge, not both, so it
  // accumulates charge (mAh) and Wh is derived in update() from that plus
  // the running average bus voltage.
  pac.setAccumulateMode(PAC1XXX_ACC_SENSE);
  pac.refresh(); // apply config, latch/reset the accumulator baseline

  tempZero.init();

  reset();
  return true;
}

void reset() {
  r = Readings(); // re-run default member initializers, avoids memset-on-non-POD warning
  vSum = iSum = pSum = 0;
  sampleCount = 0;
  sessionStartMs = millis();
  lastHistMs = 0;
  pac.refresh(); // also clears the hardware charge accumulator
}

void update() {
  uint32_t now = millis();
  if (now - lastSampleMs < SAMPLE_INTERVAL_MS) return;
  lastSampleMs = now;

  float v = pac.busVoltage();
  float i = pac.current();
  float p = pac.power();
  if (isnan(v) || isnan(i) || isnan(p)) return; // skip a bad/glitched sample

  r.voltage = v;
  r.current = i;
  r.power = p;

  if (sampleCount == 0 || v < r.vMin) r.vMin = v;
  if (sampleCount == 0 || v > r.vMax) r.vMax = v;
  if (sampleCount == 0 || i < r.iMin) r.iMin = i;
  if (sampleCount == 0 || i > r.iMax) r.iMax = i;
  if (sampleCount == 0 || p < r.pMin) r.pMin = p;
  if (sampleCount == 0 || p > r.pMax) r.pMax = p;

  vSum += v;
  iSum += i;
  pSum += p;
  sampleCount++;
  r.vAvg = vSum / sampleCount;
  r.iAvg = iSum / sampleCount;
  r.pAvg = pSum / sampleCount;

  // refresh() latches and clears the charge accumulated since the previous
  // call, so summing the results here gives a running mAh total with no
  // gap between polls.
  pac.refresh();
  r.mAh += pac.charge_mAh();
  r.Wh = (r.mAh / 1000.0f) * r.vAvg;

  // The die-temperature read is a 64-sample averaged ADC conversion that
  // blocks for ~25ms. At the 100ms sample cadence that would consume a
  // quarter of all loop time, so it runs once a second instead.
  static uint32_t lastTempMs = 0;
  if (now - lastTempMs >= 1000) {
    lastTempMs = now;
    r.temperatureC = tempZero.readInternalTemperature();
  }
  r.sessionSeconds = (now - sessionStartMs) / 1000;

  // Graph history: one point per second, oldest-first ring shifted in place.
  if (now - lastHistMs >= 1000) {
    lastHistMs = now;
    if (r.histCount < GRAPH_POINTS) {
      r.vHist[r.histCount] = v;
      r.iHist[r.histCount] = i;
      r.pHist[r.histCount] = p;
      r.histCount++;
    } else {
      memmove(r.vHist, r.vHist + 1, (GRAPH_POINTS - 1) * sizeof(float));
      memmove(r.iHist, r.iHist + 1, (GRAPH_POINTS - 1) * sizeof(float));
      memmove(r.pHist, r.pHist + 1, (GRAPH_POINTS - 1) * sizeof(float));
      r.vHist[GRAPH_POINTS - 1] = v;
      r.iHist[GRAPH_POINTS - 1] = i;
      r.pHist[GRAPH_POINTS - 1] = p;
    }
  }
}

const Readings &data() { return r; }

} // namespace PowerSensor

